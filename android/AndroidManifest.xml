<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Downloads of the games from Steam go on when the screen is gone -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The update of the application from its release on GitHub (AppUpdate.java); the system still asks the player to confirm it -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- A game folder of the phone is played from as it is (the launcher, "Use a folder on the phone"): Android 11 and newer ask for the
         access to all the files in the settings, older ones for the storage permission -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true" />
    <!-- The servers of the content of Steam answer on plain HTTP too: the data is encrypted and checked by Steam's own hashes -->
    <!-- userLandscape: landscape both ways, the screen turns by 180 degrees with the auto-rotate of the phone (a pad that is clamped to the phone the other way up); when the user has locked the rotation, it stays -->
    <application android:label="OpenGothic" android:appCategory="game" android:hasCode="true" android:allowBackup="false" android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <!-- Imports the game files and starts the game -->
        <activity android:name="org.opengothic.app.LauncherActivity" android:exported="true"
            android:screenOrientation="userLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Mods: adding of zip files and the choice of the mods that start with the game -->
        <activity android:name="org.opengothic.app.ModsActivity" android:exported="false"
            android:screenOrientation="userLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- Mods of Gothic from the database of Spine: browsing, download, play -->
        <activity android:name="org.opengothic.app.SpineActivity" android:exported="false"
            android:screenOrientation="userLandscape" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- The page of a mod of Spine: pictures, description, opinions, the check for Ikarus and LeGo -->
        <activity android:name="org.opengothic.app.SpineDetailsActivity" android:exported="false"
            android:screenOrientation="userLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <service android:name="org.opengothic.app.SpineDownloadService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- The login to Steam, the first screen when nobody is signed in -->
        <activity android:name="org.opengothic.app.SteamLoginActivity" android:exported="false"
            android:screenOrientation="userLandscape" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- The answer of the system installer to the update -->
        <receiver android:name="org.opengothic.app.UpdateReceiver" android:exported="false" />
        <service android:name="org.opengothic.app.SteamDownloadService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Runs in its own process, the launcher stays alive when the game exits -->
        <activity android:name="org.opengothic.app.GameActivity" android:exported="false" android:process=":game"
            android:screenOrientation="userLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="Gothic2Notr" />
        </activity>
    </application>
</manifest>
